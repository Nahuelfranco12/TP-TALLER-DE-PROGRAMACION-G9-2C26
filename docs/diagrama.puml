
@startuml Diagrama
class Jugador{
    - energia : double
    - vida : double
    - monedas : int 
    ' rand entre 0-100
    - inventario : Inventario
    - sectorActual : Sector&

    + mover(Posicion destino) : ResultadoMovimiento
    ' + obtenerHerramienta(enum HerramientasDisponibles herramienta) : Herramienta
    
    ' Estos metodos interactuan con el inventario
    + picar(Mineral& mineral)
    + golpear(Enemigo& enemigo)
    + cavar()
    + regar(Cultivo& cultivo)
}

class Herramienta {}
class Item {}

class EspacioInventario {
    - elemento : Item
    - cantidad : int
}

class Pico {}
class Regadera {}
class Pala {}
class Espada {}

Herramienta <|-- Pico
Herramienta <|-- Regadera
Herramienta <|-- Pala
Herramienta <|-- Espada

class Animal {}
class Vaca {}
class Gallina {}
Animal <|-- Vaca
Animal <|-- Gallina

class Semilla {}
Item <|-- Semilla

class ProductoDecoracion {}
class Cofre {}
class Cama {
    - jugadorDueño : Jugador

    - dormir()
}
ProductoDecoracion <|-- Cofre
ProductoDecoracion <|-- Cama
Cama --> Jugador

class ItemMineral {
    - precio : double
}
class Cultivo {}
class CultivoCosechado {}
class ProductoAnimal {}
Item <|-- ItemMineral
Item <|-- ProductoAnimal
Item <|-- CultivoCosechado

class Inventario {
    - items : list<EspacioInventario>
    - herramientas : list<Herramienta>

    + agregarItem(Item& item)
    + agregarHerramienta(Herramienta& herramienta)
}
Inventario o-- EspacioInventario
EspacioInventario o-- Item
Inventario o-- Herramienta
Jugador *-- Inventario

' %% Revisar patron builder para Mineral y Enemigo
class Mineral {
    - frecuencia
    - tiempo

    + efectoAlPicar()
}

class Enemigo {
    - combate
    - dificultad
    - spawn
    - particularidad
}

class Caverna {
    - list<Nivel>
}

class Nivel {}

Caverna *-- Nivel

class Granja {}

class Pueblo {
    - mercado : Mercado
    - centro : CentroComunitario
}

class Mercado {
    - list<Comerciante>
}

' %% Con varias habitaciones y objetivos
class CentroComunitario {
    - list<Set>
}

class Set {}

CentroComunitario *-- Set

' %% Marnie, Clint, Pierre, Robin
class Comerciante {}

Pueblo *-- Mercado
Pueblo *-- CentroComunitario

Mercado o-- Comerciante

class Mundo {
    - sectores : map<IdSector, Sector>
    - jugadores : list<Jugador>

    + transferir(EntidadDeMapa& e, IdSector destino, Posicion pos) : bool
}
Mundo o-- Jugador

enum IdSector {
    GRANJA
    PUEBLO
    CAVERNA_NIVEL
}
Mundo --o IdSector

class Sector {
    - id : IdSector
    - casillas : Terreno[ALTO][ANCHO]
    - entidades : Map<Posicion, EntidadDeMapa&>
    - puertas : Map<Posicion, Puerta>

    + mover(EntidadDeMapa& e, Posicion destino) : ResultadoMovimiento
    + estaLibre(Posicion pos) : bool
    + agregar(EntidadDeMapa& e, Posicion pos) : bool
    + quitar(EntidadDeMapa& e)
}
Sector *-- IdSector
Mundo *-- Sector
Sector o-- EntidadDeMapa
Sector <|-- Granja
Sector <|-- Pueblo
Sector <|-- Nivel
Jugador --> Sector : sectorActual

enum TipoTerreno {
    TIERRA
    PASTO
    PISO
}

class Terreno {
    - transitable : bool
    - arable : bool
    - tipoTerreno : TipoTerreno

    + esTransitable() : bool
    + esArable() : bool
    + obtenerTextura() : Textura
}
Terreno *-- TipoTerreno
Sector ..> Terreno

class Posicion {
    - x : int
    - y : int
}
Sector ..> Posicion

class Puerta {
    - idSectorDestino : IdSector
    - posicionDestino : Posicion
}
Sector *-- Puerta

class EntidadDeMapa {
    - posicion : Posicion
}
Posicion <-- EntidadDeMapa
Posicion <-- Puerta

EntidadDeMapa <|-- Enemigo
EntidadDeMapa <|-- Animal
EntidadDeMapa <|-- Mineral
EntidadDeMapa <|-- Cultivo
EntidadDeMapa <|-- ProductoDecoracion
EntidadDeMapa <|-- Puerta
EntidadDeMapa <|-- Jugador

class ResultadoMovimiento {
    - exito : bool
    - posicion : Posicion
    - idSector : IdSector
}
Jugador --> ResultadoMovimiento
Sector --> ResultadoMovimiento
@enduml
